#!/usr/bin/env python3
"""
url2org — robuuste versie (Trafilatura standaard, Readability optioneel)

Gebruik:
  url2org URL [--dir DIR] [--name BESTAND.org] [--open] [--snapshot]
              [--append DOEL.org] [--readability]
              [--no-unwrap] [--no-softfix] [--debug]

Afhankelijkheden (in jouw venv):
  pip install trafilatura cssselect readability-lxml requests
  sudo apt install pandoc  (optioneel, voor betere conversie)
"""

import argparse, datetime, os, re, shutil, subprocess, sys, tempfile, textwrap
from html import unescape
from pathlib import Path


# ───────────────────────────── helpers ─────────────────────────────

def have(cmd:str)->bool:
    return shutil.which(cmd) is not None


def slugify(s:str)->str:
    s = s.strip().lower()
    s = re.sub(r"[^\w\s-]", "", s)
    s = re.sub(r"[\s_-]+","-", s).strip("-")
    return s or "artikel"


def sanitize_filename_component(name: str) -> str:
    """Maak een leesbare, filesystem-veilige bestandsnaamcomponent."""
    cleaned = unescape((name or "").strip())
    cleaned = re.sub(r"\s+", " ", cleaned)
    cleaned = re.sub(r'[<>:"/\\|?*]', "_", cleaned)
    cleaned = cleaned.strip(" ._")
    if len(cleaned) > 120:
        cleaned = cleaned[:120].rstrip(" ._")
    return cleaned or "artikel"


def extract_html_title(html_text: str) -> str:
    """Haal een titel uit meta-tags of <title>."""
    if not html_text:
        return ""
    patterns = (
        r'<meta[^>]+property=["\']og:title["\'][^>]*content=["\']([^"\']+)["\']',
        r'<meta[^>]+name=["\']og:title["\'][^>]*content=["\']([^"\']+)["\']',
        r'<meta[^>]+name=["\']twitter:title["\'][^>]*content=["\']([^"\']+)["\']',
        r'<meta[^>]+name=["\']title["\'][^>]*content=["\']([^"\']+)["\']',
    )
    for pattern in patterns:
        m = re.search(pattern, html_text, flags=re.I)
        if m:
            candidate = unescape(m.group(1)).strip()
            if candidate:
                return re.sub(r"\s+", " ", candidate)
    m = re.search(r"<title[^>]*>(.*?)</title>", html_text, flags=re.I | re.S)
    if m:
        candidate = unescape(m.group(1)).strip()
        return re.sub(r"\s+", " ", candidate)
    return ""


def nowstamp()->str:
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M")


# ───────────────────────────── inhoud ophalen ─────────────────────────────

def trafilatura_extract(url: str, html_text: str = "") -> tuple[str, str, str]:
    """Gebruik Trafilatura voor schonen + optioneel markdown."""
    try:
        import trafilatura
    except ModuleNotFoundError:
        sys.stderr.write(
            "[url2org] 'trafilatura' ontbreekt in deze venv.\n"
            f"Installeer in de shebang-venv:\n  {sys.executable} -m pip install trafilatura cssselect\n"
        )
        return "", "", html_text

    raw = html_text or trafilatura.fetch_url(url)
    if not raw:
        return "", "", html_text

    kw = {"include_tables": True, "include_formatting": True, "include_links": True}
    try:
        md = trafilatura.extract(raw, output_format="markdown", **kw) or ""
    except Exception:
        md = ""
    try:
        clean_html = trafilatura.extract(raw, output_format="html", **kw) or ""
    except Exception:
        clean_html = ""
    return md, clean_html, raw


def requests_get(url: str) -> str:
    """Kleine fetcher met nette User-Agent."""
    try:
        import requests
        headers = {"User-Agent": "url2org/1.0 (+linux)"}
        r = requests.get(url, headers=headers, timeout=20)
        r.raise_for_status()
        r.encoding = r.apparent_encoding or r.encoding
        return r.text
    except Exception as exc:
        sys.stderr.write(f"[url2org] Ophalen van {url} mislukt: {exc}\n")
        return ""


def pandoc_to_org_from_html(html: str) -> str:
    """HTML → Org via pandoc; bij ontbreken pandoc: simpele tekstfallback."""
    if not html.strip():
        return ""
    if have("pandoc"):
        with tempfile.NamedTemporaryFile("w+", suffix=".html", delete=False, encoding="utf-8") as tf:
            tf.write(html)
            tf.flush()
            res = subprocess.run(
                ["pandoc", "-f", "html", "-t", "org", "--wrap=none", tf.name],
                text=True, capture_output=True
            )
        try:
            os.unlink(tf.name)
        except Exception:
            pass
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout
    txt = re.sub(r"<[^>]+>", "", html)
    txt = re.sub(r"\s+", " ", txt).strip()
    if not txt:
        return ""
    return "#+begin_quote\n" + txt + "\n#+end_quote\n"


def pandoc_convert_text(text: str, from_fmt: str, to_fmt: str):
    """Converteer tekst via pandoc; return bytes voor docx, str voor tekst."""
    if not have("pandoc"):
        sys.stderr.write("[url2org] Voor --format != org is pandoc vereist.\n")
        sys.exit(6)
    import tempfile
    suffix = "." + (from_fmt if from_fmt != "org" else "org")
    with tempfile.NamedTemporaryFile("w+", delete=False, encoding="utf-8", suffix=suffix) as tf:
        tf.write(text); tf.flush(); inpath = tf.name
    try:
        args = ["pandoc", "-f", from_fmt, "-t", to_fmt, "--wrap=none"]
        if to_fmt == "typst":
            lua_filter = Path(__file__).with_name("hrule.lua")
            if lua_filter.exists():
                args.extend(["--lua-filter", str(lua_filter)])
        args.append(inpath)
        out = subprocess.run(args, capture_output=True)
        if out.returncode != 0:
            sys.stderr.write("[url2org] pandoc conversie faalde.\n")
            sys.exit(7)
        return out.stdout
    finally:
        try: os.unlink(inpath)
        except Exception: pass


def readability_extract_to_org(url: str, html_text: str = "") -> str:
    """Gebruik Readability om hoofdcontent te pakken en omzetting naar Org."""
    try:
        from readability import Document
    except Exception:
        return ""
    if not html_text:
        html_text = requests_get(url)
    if not html_text:
        return ""
    try:
        main_html = Document(html_text).summary(html_partial=True) or ""
    except Exception:
        main_html = ""
    return pandoc_to_org_from_html(main_html)


# ───────────────────────────── conversies ─────────────────────────────

def unwrap_markdown(md: str) -> str:
    """Zachte regeleinden binnen alinea’s samenvoegen."""
    lines = md.splitlines()
    out, buf = [], ""
    import re
    fence = re.compile(r"^(```|~~~)")
    is_list = re.compile(r"^\s*(?:[*+-]\s+|\d+\.\s+)")
    is_hdr  = re.compile(r"^\s*#{1,6}\s+")
    is_quote= re.compile(r"^\s*>\s+")
    is_table= re.compile(r"^\s*\|")
    in_code = False

    for line in lines:
        if fence.match(line):
            if buf: out.append(buf.strip()); buf = ""
            in_code = not in_code
            out.append(line)
            continue
        if in_code or not line.strip() or is_hdr.match(line) or \
           is_list.match(line) or is_quote.match(line) or is_table.match(line):
            if buf: out.append(buf.strip()); buf = ""
            out.append(line)
            continue
        if not buf:
            buf = line.strip()
        else:
            if buf.endswith('-'):
                buf = buf[:-1] + line.lstrip()
            else:
                buf += ' ' + line.strip()
    if buf:
        out.append(buf.strip())
    text = "\n".join(out)
    text = re.sub(r"(?i)<br\s*/?>", "\n\n", text)
    return text


def md_to_org(md: str) -> str:
    """Gebruik pandoc als het er is; anders markdown in quote."""
    if not md.strip():
        return ""
    if have("pandoc"):
        with tempfile.NamedTemporaryFile("w+", suffix=".md", delete=False, encoding="utf-8") as tf:
            tf.write(md)
            tf.flush()
            out = subprocess.run(["pandoc","-f","markdown","-t","org","--wrap=none",tf.name],
                                 text=True, capture_output=True)
        try:
            os.unlink(tf.name)
        except Exception:
            pass
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout
    return "#+begin_quote\n" + md.rstrip() + "\n#+end_quote\n"


def softbreak_fix_org(org_text: str) -> str:
    """Voeg alleen gewone alinearegels samen; laat Org-structuur intact."""
    out, paragraph = [], []
    block_depth = 0
    in_drawer = False

    def flush():
        if paragraph:
            text = "\n".join(paragraph)
            text = re.sub(r"\\{2}[ \t]*(?:\n|$)", "\n\n", text)
            text = re.sub(r"([^\n])\n(?!\n)", r"\1 ", text)
            out.append(text)
            paragraph.clear()

    for line in org_text.splitlines():
        begin = re.match(r"^\s*#\+begin_", line, re.I)
        end = re.match(r"^\s*#\+end_", line, re.I)
        drawer = re.match(r"^\s*:[\w-]+:\s*$", line)
        structural = re.match(r"^(?:\s|\*+\s|[-+]\s|\d+[.)]\s|\||#|:|>\s)", line)
        if block_depth or in_drawer or begin or drawer or structural or not line.strip():
            flush()
            out.append(line)
            if begin:
                block_depth += 1
            elif end and block_depth:
                block_depth -= 1
            if not block_depth and drawer:
                in_drawer = line.strip().upper() != ":END:"
        else:
            paragraph.append(line)
    flush()
    return "\n".join(out) + ("\n" if org_text.endswith("\n") else "")


def fill_wrap_org(org_text: str, width: int = 65) -> str:
    """Wrap normale tekstpassages tot ~width tekens (zoals fill-column)."""
    wrapper = textwrap.TextWrapper(
        width=width,
        break_long_words=False,
        break_on_hyphens=False,
    )

    lines = org_text.splitlines()
    out = []
    buffer: list[str] = []
    in_properties = False
    in_block = False

    def flush_buffer() -> None:
        if not buffer:
            return
        paragraph = " ".join(line.strip() for line in buffer if line.strip())
        if not paragraph:
            out.append("")
        else:
            wrapped = wrapper.fill(paragraph)
            out.append(wrapped)
        buffer.clear()

    for line in lines:
        stripped = line.strip()

        # Detect block boundaries we should not wrap
        is_heading = line.startswith("*")
        is_list = re.match(r"^\s*([*+-]|\d+[.)])\s", line)
        is_table = line.startswith("|")
        is_block_begin = re.match(r"^\s*#\+begin_", line, re.I)
        is_block_end = re.match(r"^\s*#\+end_", line, re.I)
        is_keyword = re.match(r"^\s*#\+", line)
        is_property_start = line.strip() == ":PROPERTIES:"
        is_property_end = line.strip() == ":END:"
        is_property_line = line.startswith(":") and ":" in line

        if is_property_start:
            flush_buffer()
            in_properties = True
            out.append(line)
            continue
        if is_property_end:
            flush_buffer()
            in_properties = False
            out.append(line)
            continue
        if in_properties or is_property_line:
            flush_buffer()
            out.append(line)
            continue

        if is_block_begin:
            flush_buffer()
            in_block = True
            out.append(line)
            continue
        if is_block_end:
            flush_buffer()
            in_block = False
            out.append(line)
            continue

        if is_heading or is_list or is_table or is_keyword or in_block or line[:1].isspace():
            flush_buffer()
            out.append(line)
            continue

        if stripped == "":
            flush_buffer()
            out.append("")
            continue

        buffer.append(line)

    flush_buffer()

    return "\n".join(out)


# ───────────────────────────── helpers voor titel & opslag ─────────────────────────────

def title_guess(url: str, org_body: str, md: str) -> str:
    m = re.search(r"^\*+\s+(.+)$", org_body, flags=re.M)
    if m: return m.group(1).strip()
    m = re.search(r"^#\s+(.+)$", md, flags=re.M)
    if m: return m.group(1).strip()
    return re.sub(r"^https?://","",url).split("/")[0]


def build_entry(title: str, url: str, body_org: str) -> str:
    props = textwrap.dedent(f"""\
    :PROPERTIES:
    :ADDED:    {nowstamp()}
    :SOURCE:   {url}
    :END:
    """)
    return f"* {title}\n{props}\n{body_org if body_org.strip() else ''}\n"


def snapshot_html(url: str, dest_dir: Path):
    if not have("wget"): return None
    slug = slugify(re.sub(r"^https?://","",url))
    outfile = dest_dir / f"{slug}.html"
    res = subprocess.run(["wget","-q","-O",str(outfile),url])
    return outfile if res.returncode==0 and outfile.exists() else None


# ───────────────────────────── main ─────────────────────────────

def main():
    ap = argparse.ArgumentParser(description="URL → Org (Trafilatura standaard, Readability optioneel)")
    ap.add_argument("url", help="Te capturen URL")
    ap.add_argument("--dir", help="Doelmap (default: huidige map)")
    ap.add_argument("--name", help="Bestandsnaam (default: datum-titel.org)")
    ap.add_argument("--open", action="store_true", help="Open in emacsclient na schrijven")
    ap.add_argument("--snapshot", action="store_true", help="Bewaar ook .html naast .org")
    ap.add_argument("--append", metavar="DOEL", help="Voeg entry toe aan bestaand Org-bestand")
    ap.add_argument("--readability", action="store_true",
                    help="Gebruik Readability-parsing (neem resultaat over als beschikbaar)")
    ap.add_argument("--no-unwrap", action="store_true",
                    help="Schakel samenvoegen van soft linebreaks in Markdown uit")
    ap.add_argument("--no-softfix", action="store_true",
                    help="Schakel postprocessing van soft linebreaks in Org uit")
    ap.add_argument("--no-fill", action="store_true",
                    help="Schakel tekst-wrapping (~fill-column~) rond 65 tekens uit")
    ap.add_argument("--debug", action="store_true", help="Extra logging naar stderr")
    ap.add_argument("--format", choices=["org","markdown","typst","latex","docx"], action="append",
                    help="Uitvoerformaat; herhaal voor meerdere exports (default: org)")
    args = ap.parse_args()
    formats = list(dict.fromkeys(args.format or ["org"]))
    if args.append and formats != ["org"]:
        ap.error("--append werkt alleen met --format org")

    url = args.url.strip()
    base = Path(args.dir).expanduser() if args.dir else Path.cwd()
    base.mkdir(parents=True, exist_ok=True)

    page_html = requests_get(url)
    if not page_html.strip():
        sys.stderr.write("[url2org] Geen webpagina opgehaald; er is niets opgeslagen.\n")
        sys.exit(4)

    # ── 1) Trafilatura basis ──
    md, clean_html, raw_html = trafilatura_extract(url, page_html)
    if not page_html and raw_html:
        page_html = raw_html
    if args.debug:
        sys.stderr.write(f"[url2org] trafilatura md chars: {len(md)}\n")
        sys.stderr.write(f"[url2org] trafilatura html chars: {len(clean_html)}\n")

    org_body = ""
    if clean_html.strip():
        org_body = pandoc_to_org_from_html(clean_html)
    if not org_body.strip() and page_html:
        html_org = pandoc_to_org_from_html(page_html)
        if html_org.strip():
            org_body = html_org
    if not org_body.strip():
        if md and not args.no_unwrap:
            md = unwrap_markdown(md)
        org_body = md_to_org(md)

    # ── 2) optioneel Readability-resultaat overnemen ──
    if args.readability:
        read_org = readability_extract_to_org(url, page_html)
        if args.debug:
            sys.stderr.write(f"[url2org] readability org chars: {len(read_org)}\n")
        if read_org.strip():
            org_body = read_org

    if not org_body.strip():
        sys.stderr.write("[url2org] Geen inhoud gevonden; er is niets opgeslagen.\n")
        sys.exit(5)

    if org_body and not args.no_softfix:
        org_body = softbreak_fix_org(org_body)

    if org_body and not args.no_fill:
        org_body = fill_wrap_org(org_body, width=65)

    derived_title = title_guess(url, org_body, md)
    meta_title = extract_html_title(page_html)
    title = meta_title or derived_title
    if not title.strip():
        title = derived_title or "Captured page"

    if args.snapshot:
        snap = snapshot_html(url, base)
        if snap:
            org_body = (org_body.rstrip() + f"\n\nLokaal: file:{snap}\n")

    # ── 3) bestand schrijven ──
    today = datetime.datetime.now().strftime("%Y-%m-%d")
    if args.name:
        fname = args.name
    else:
        safe_title = sanitize_filename_component(title)
        fname = f"{safe_title} - {today}" if safe_title else today
    ext_map = {"org":"org", "markdown":"md", "typst":"typ", "latex":"tex", "docx":"docx"}
    entry = build_entry(title, url, org_body)

    if args.append:
        target = base / args.append
        if not target.exists():
            sys.stderr.write(f"[url2org] Bestand {target} bestaat niet.\n")
            sys.exit(3)
        with open(target, "a", encoding="utf-8") as f:
            f.write("\n" + entry)
        outputs = [(target, "org")]
    else:
        outputs = []
        for fmt in formats:
            outpath = base / f"{fname}.{ext_map[fmt]}"
            i, stem = 2, outpath.stem
            while outpath.exists():
                outpath = outpath.with_name(f"{stem}-{i}.{ext_map[fmt]}"); i += 1
            if fmt == "org":
                outpath.write_text(entry, encoding="utf-8")
            else:
                out_bytes = pandoc_convert_text(entry, "org", fmt)
                if fmt == "docx":
                    outpath.write_bytes(out_bytes)
                else:
                    text_out = out_bytes.decode("utf-8", "replace")
                    if fmt == "typst":
                        header = "#set page(\"a5\")\n\n"
                        body = text_out.lstrip()
                        if body.startswith("#set page"):
                            body_lines = body.splitlines()
                            body = "\n".join(body_lines[1:]).lstrip("\n")
                        text_out = header + body
                    outpath.write_text(text_out, encoding="utf-8")
            outputs.append((outpath, fmt))

    for out, fmt in outputs:
        print(str(out))
        if args.open and fmt != "docx":
            if have("emacsclient"):
                subprocess.run(["emacsclient","-n",str(out)])
            else:
                sys.stderr.write("Tip: installeer emacsclient voor --open.\n")

if __name__ == "__main__":
    main()
